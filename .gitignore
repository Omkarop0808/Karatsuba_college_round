# ==============================================================================
# Comprehensive Root .gitignore for Blockchain / ZK-EVM Monorepo
# Subprojects: Node.js, Next.js, Foundry/Solidity, Circom/ZK, Python, Rust/Cargo,
#              Worker TypeScript, OS metadata, IDEs, Logs & Test Artifacts
# ==============================================================================

# ------------------------------------------------------------------------------
# Reference Applications & External Repositories
# ------------------------------------------------------------------------------
reference-app/

# ------------------------------------------------------------------------------
# 1. Environment Variables, Secrets & Sensitive Credentials
# ------------------------------------------------------------------------------
.env
.env.*
*.env
*.env.*
# Allow committed template/example files
!.env.example
!.env*.example
!.env.template
!.env*.template

# Private keys and certificates (preserving Circom *.zkey)
*.pem
*.key
!*.zkey
*.cert
*.crt
*.pfx
*.p12
*.keystore
id_rsa
id_ecdsa
id_ed25519

# ------------------------------------------------------------------------------
# 2. Dependencies & Package Managers (Node.js, Yarn, pnpm)
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
jspm_packages/

# Yarn & pnpm artifacts
.pnp/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store/

# ------------------------------------------------------------------------------
# 3. Next.js, Frontend & Build Outputs
# ------------------------------------------------------------------------------
.next/
**/.next/
.turbo/
**/.turbo/
.vercel/
**/.vercel/
dist/
**/dist/
*.tsbuildinfo
next-env.d.ts

